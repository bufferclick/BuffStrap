<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.FavoriteShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        Title="Create shortcut" Width="430" MinWidth="0" MinHeight="0" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid Background="{DynamicResource MainWindowBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="8" Title="Create shortcut" Icon="pack://application:,,,/Bloxstrap.ico"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
        <StackPanel Grid.Row="1" Margin="20,12,20,16">
            <TextBlock Text="Where should the shortcut appear?" FontSize="17" FontWeight="Medium" />
            <CheckBox x:Name="DesktopCheck" Content="Desktop" IsChecked="True" Margin="0,14,0,0" />
            <CheckBox x:Name="StartMenuCheck" Content="Start menu" Margin="0,10,0,0" />
            <TextBlock Text="The shortcut uses the favorite's current game and account assignment. It opens this copy of BuffStrap, so keep the executable where it is."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,14,0,0" />
            <TextBlock Text="If another file already has that name, a number is added rather than replacing it."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Row="2" Padding="16" Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Content="Create" MinWidth="90" Click="Create_Click" />
                <ui:Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
