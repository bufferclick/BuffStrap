<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.CursorLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        Title="Custom cursors" Width="860" Height="760" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid Background="{DynamicResource MainWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="8" Title="Custom cursors" Icon="pack://application:,,,/Bloxstrap.ico"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
        <StackPanel Grid.Row="1" Margin="18,6,18,10">
            <TextBlock Text="Browse the cursor library below and press a set's Download. The zip is taken straight into BuffStrap, never into your Downloads folder."
                       TextWrapping="Wrap" />
            <TextBlock Text="Roblox draws its pointer from one image, so a set contributes its normal arrow only. It appears the next time Roblox starts through BuffStrap."
                       TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
        <web:WebView2 x:Name="Browser" Grid.Row="2" Margin="18,0,18,0" />
        <Grid Grid.Row="3" Margin="18,12,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                <Image x:Name="Preview" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Opening the cursor library..." TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="12,0,12,0" />
            <ui:Button Grid.Column="2" Content="Open in browser" Click="OpenExternal_Click" />
            <ui:Button Grid.Column="3" Content="Done" Margin="8,0,0,0" Click="Done_Click" />
        </Grid>
    </Grid>
</base:WpfUiWindow>
