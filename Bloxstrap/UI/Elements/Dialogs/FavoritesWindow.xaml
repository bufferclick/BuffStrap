<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        Title="BuffStrap Favorites" Width="980" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid Background="{DynamicResource MainWindowBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="8" Title="Favorites" Icon="pack://application:,,,/Bloxstrap.ico"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
        <TabControl Grid.Row="1" Margin="18,6,18,18">
            <TabItem Header="Favorites">
                <Grid Margin="12,14,12,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="YOUR COLLECTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemAccentBrush}" />
                            <TextBlock Text="Favorite games" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,0" />
                            <TextBlock Text="Your saved games and account assignments." FontSize="13" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Add game" Icon="Add20" Appearance="Primary" VerticalAlignment="Center" Click="AddGame_Click" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="185" /></Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchBox" PlaceholderText="Search games, folders or accounts" AutomationProperties.Name="Search favorites"
                                    TextChanged="Filter_Changed" Margin="0,0,8,0" />
                        <ComboBox x:Name="FolderFilter" Grid.Column="1" AutomationProperties.Name="Filter by folder" SelectionChanged="Filter_Changed" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="EmptyGames" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="Favorite games">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" /></ControlTemplate></Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,10" Loaded="FavoriteCard_Loaded" DataContextChanged="FavoriteCard_DataContextChanged">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="128" Height="128" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="Games24" FontSize="35" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Border CornerRadius="10"><Border.Background><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" /></Border.Background></Border>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Column="1" Margin="4,0,14,0">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="{Binding Metadata}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Text="{Binding Description}" ToolTip="{Binding Description}" FontSize="12" Margin="0,9,0,4"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" VerticalAlignment="Top"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="3" Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <ui:Button Content="Play" Icon="Play20" Appearance="Success" Foreground="White" IconForeground="White"
                                                           MinWidth="126" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                           ToolTip="Play this favorite" Click="PlayGame_Click" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                                                    <ui:Button Icon="Edit20" Width="38" ToolTip="Edit favorite" AutomationProperties.Name="Edit favorite" Click="EditGame_Click" />
                                                    <ui:Button Icon="Desktop20" Width="38" Margin="6,0,0,0" ToolTip="Create shortcut" AutomationProperties.Name="Create shortcut" Click="Shortcut_Click" />
                                                    <ui:Button Icon="Delete20" Width="38" Margin="6,0,0,0" ToolTip="Remove favorite" AutomationProperties.Name="Remove favorite" Click="RemoveGame_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Recently Played">
                <Grid Margin="12,14,12,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Recently played" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Games are recorded after joining while activity tracking is enabled. Up to 50 are kept on this device."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Clear history" Margin="12,0,0,0" VerticalAlignment="Center" Click="ClearRecent_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <ui:Card Margin="0,0,0,8"><Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="Play" Icon="Play20" Click="PlayRecent_Click" />
                                </Grid></ui:Card>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Accounts">
                <StackPanel Margin="12,14,12,4">
                    <TextBlock Text="Your Roblox accounts" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Add or reconnect accounts in Account Manager, then assign one when editing a favorite. Roblox may require you to sign in again."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />
                    <ui:Button Content="Open Account Manager" Icon="Person24" HorizontalAlignment="Left" Click="ManageAccounts_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</base:WpfUiWindow>
