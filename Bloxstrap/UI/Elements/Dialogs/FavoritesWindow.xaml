<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        Title="BuffStrap Favorites" Width="900" Height="650" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid Background="{DynamicResource MainWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="8" Title="Favorites" Icon="pack://application:,,,/Bloxstrap.ico"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
        <TabControl Grid.Row="1" Margin="16,8,16,16">
            <TabItem Header="Favorites">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Your games, organized your way" FontSize="20" FontWeight="Medium" Margin="0,0,0,12" />
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="185" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search games, folders or accounts" TextChanged="Filter_Changed" Margin="0,0,8,0" />
                        <ComboBox x:Name="FolderFilter" Grid.Column="1" SelectionChanged="Filter_Changed" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="2" Content="Add game" Icon="Add28" Click="AddGame_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="GamesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <ui:Button Content="▶ Play" ToolTip="Play this favorite" Click="PlayGame_Click" />
                                                <ui:Button Content="Edit" Margin="6,0,0,0" Click="EditGame_Click" />
                                                <ui:Button Content="Shortcut" Margin="6,0,0,0" Click="Shortcut_Click" />
                                                <ui:Button Content="Remove" Margin="6,0,0,0" Click="RemoveGame_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Recently Played">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Recently Played" FontSize="20" FontWeight="Medium" />
                            <TextBlock Text="Games are recorded after joining while BuffStrap activity tracking is enabled. Up to 50 are kept on this device."
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Clear history" Margin="12,0,0,0" Click="ClearRecent_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Content="▶ Play" Click="PlayRecent_Click" />
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Accounts">
                <StackPanel Margin="12">
                    <TextBlock Text="Your Roblox accounts" FontSize="20" FontWeight="Medium" />
                    <TextBlock Text="Add or reconnect accounts in Account Manager, then assign one when editing a favorite. Roblox may require you to sign in again."
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <ui:Button Content="Open Account Manager" Icon="Person24" HorizontalAlignment="Left" Click="ManageAccounts_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</base:WpfUiWindow>
