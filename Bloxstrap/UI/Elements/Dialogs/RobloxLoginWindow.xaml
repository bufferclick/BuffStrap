<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.RobloxLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        Title="Sign in to Roblox" Width="760" Height="760" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid Background="{DynamicResource MainWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="8" Title="Sign in to Roblox" Icon="pack://application:,,,/Bloxstrap.ico"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
        <StackPanel Grid.Row="1" Margin="18,6,18,10">
            <TextBlock Text="Sign in on the official Roblox page below, including any verification." TextWrapping="Wrap" />
            <TextBlock Text="BuffStrap does not save your password. Your session is protected for this Windows user and excluded from backups."
                       TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
        <!-- Source is set only after a separate InPrivate controller is initialized. -->
        <web:WebView2 x:Name="Browser" Grid.Row="2" Margin="18,0,18,0" />
        <Grid Grid.Row="3" Margin="18,12,18,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Opening Roblox..." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ui:Button x:Name="SaveButton" Grid.Column="1" Content="I've signed in" IsEnabled="False" Click="Save_Click" />
            <ui:Button Grid.Column="2" Content="Cancel" Margin="8,0,0,0" Click="Cancel_Click" />
        </Grid>
    </Grid>
</base:WpfUiWindow>
