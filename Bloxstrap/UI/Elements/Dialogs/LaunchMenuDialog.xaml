<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.LaunchMenuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:Bloxstrap.Resources"
        Title="BuffStrap"
        MinWidth="0"
        MinHeight="0"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource MainWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" ShowMinimize="False" ShowMaximize="False"
                     Title="BuffStrap" Icon="pack://application:,,,/Bloxstrap.ico" CanMaximize="False"
                     KeyboardNavigation.TabNavigation="None" />

        <Grid Grid.Row="1" Margin="24,18,24,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Only shown by pre-release builds, where it replaces the usual mark. -->
                <Image x:Name="AlphaLogo" Width="76" Height="76" Margin="0,0,0,12" Visibility="Collapsed"
                       Source="pack://application:,,,/Resources/BuffStrapAlpha.png"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Image Width="220" Height="52" Source="{DynamicResource BuffStrapWordmark}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Version, Mode=OneTime}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                <ui:CardAction x:Name="LaunchRobloxAction" Icon="ArrowRight12" TabIndex="0"
                               Command="{Binding LaunchRobloxCommand, Mode=OneTime}">
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" />
                </ui:CardAction>
                <ui:CardAction x:Name="LaunchSettingsAction" Margin="0,8,0,0" Icon="Settings28" TabIndex="1"
                               Command="{Binding LaunchSettingsCommand, Mode=OneTime}">
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.LaunchMenu_ConfigureSettings}" />
                </ui:CardAction>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="AccountsButton" Grid.Column="0" Margin="0,0,4,0" Height="44"
                               Icon="Person24" FontSize="18" ToolTip="Accounts" AutomationProperties.Name="Accounts"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" TabIndex="2"
                               Command="{Binding LaunchAccountsCommand, Mode=OneTime}" />
                    <ui:Button x:Name="FavoritesButton" Grid.Column="1" Margin="4,0,0,0" Height="44"
                               Icon="Star24" FontSize="18" ToolTip="Favorites" AutomationProperties.Name="Favorites"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" TabIndex="3"
                               Command="{Binding LaunchFavoritesCommand, Mode=OneTime}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</base:WpfUiWindow>
