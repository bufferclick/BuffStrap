<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        Title="BuffStrap update" Width="430" Height="235" MinWidth="0" MinHeight="0"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource MainWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="8" Title="BuffStrap update" Icon="pack://application:,,,/Bloxstrap.ico"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
        <StackPanel Grid.Row="1" Margin="24,12,24,20">
            <TextBlock x:Name="StatusText" FontSize="17" FontWeight="SemiBold" Text="Getting the latest BuffStrap..." />
            <TextBlock Text="Your settings and shortcuts will be kept." Margin="0,5,0,15"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" Value="0" />
            <ui:Button Content="Cancel" Click="Cancel_Click" HorizontalAlignment="Right" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</base:WpfUiWindow>
